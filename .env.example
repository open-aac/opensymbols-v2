LEGACY_SERVER_URL=http://127.0.0.1:3001
LEGACY_SERVER_TIMEOUT_MS=10000
LEGACY_SERVER_PORT=3001
VITE_SERVER_PROXY_TARGET=http://localhost:3000

# Optional Clerk development configuration for user accounts. Public routes work without it.
# Use the publishable key in the browser. Keep the JWT public key server-side only.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://localhost:5173,http://127.0.0.1:5173
# Server-only Standard Webhooks secret for the deployed Clerk user.deleted endpoint.
CLERK_WEBHOOK_SIGNING_SECRET=

# Local development values used by Docker Compose. Do not reuse them in production.
POSTGRES_USER=opensymbols
POSTGRES_PASSWORD=opensymbols
POSTGRES_DB=opensymbols_development
POSTGRES_PORT=5432
# Hono public API signing. Use independent random values outside local development.
PUBLIC_API_TOKEN_SIGNING_KEY=local-development-public-api-signing-key
# Configure only during the maximum 36-hour legacy-token overlap.
# PUBLIC_API_LEGACY_TOKEN_VERIFICATION_KEY=
# Migration-only; needed only if a legacy snapshot contains encrypted GoSecure rows.
# LEGACY_GOSECURE_DECRYPTION_KEY=
# Dormant Rails service only. Remove with the Rails service.
SECURE_ENCRYPTION_KEY=local-development-secure-encryption-key
DEMO_ASSET_BASE_URL=http://localhost:5173/demo-symbols

# Optional override for the Vite production build served by Hono.
# SITE_DIST_PATH=C:/absolute/path/to/apps/site/dist

# Optional provider-neutral discovery reads. PostgreSQL remains the default and
# is still required for symbol requests and public API credentials.
DISCOVERY_PROVIDER=postgres
MEILISEARCH_HOST=
MEILISEARCH_SEARCH_API_KEY=
# MEILISEARCH_SYMBOL_INDEX=symbols
# MEILISEARCH_REPOSITORY_INDEX=repositories
# MEILISEARCH_TIMEOUT_MS=5000

# PostgreSQL-to-Meilisearch rebuild configuration. Store real values only in
# the ignored .env.search-indexer file or an approved secret manager.
MEILISEARCH_INDEX_API_KEY=
# Approved beta guardrail for stable and candidate indexes combined.
MEILISEARCH_DOCUMENT_LIMIT=700000
S3_BUCKET=
S3_CDN=

# Private quarantine storage for administrator library-import drafts. The
# bucket must block public access and expire imports/ objects after 30 days.
IMPORT_QUARANTINE_BUCKET=
IMPORT_QUARANTINE_REGION=us-west-1
# Optional for an S3-compatible provider. Leave unset for AWS S3.
# IMPORT_QUARANTINE_ENDPOINT=
# IMPORT_QUARANTINE_FORCE_PATH_STYLE=false
