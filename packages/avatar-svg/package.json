{
  "name": "@opensymbols/avatar-svg",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./src/contracts.ts",
      "default": "./dist/contracts.js"
    },
    "./react": {
      "types": "./src/react.tsx",
      "default": "./dist/react.js"
    },
    "./browser": {
      "types": "./src/browser.ts",
      "default": "./dist/browser.js"
    }
  },
  "scripts": {
    "art:compile": "tsx scripts/compile-art-kit.ts",
    "art:validate": "tsx scripts/validate-art-kit.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test -c playwright.config.ts"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@xmldom/xmldom": "^0.8.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.20.0",
    "vite": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
