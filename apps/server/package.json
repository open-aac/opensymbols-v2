{
  "name": "@opensymbols/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:database": "cross-env RUN_DATABASE_INTEGRATION=1 vitest run src/integration/public-read-store.test.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.11.7",
    "@hono/node-server": "^2.0.10",
    "hono": "^4.12.30",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10"
  }
}
