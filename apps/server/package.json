{
  "name": "@opensymbols/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "data:generate": "tsx scripts/generate-search-data.ts",
    "data:scale": "tsx scripts/generate-search-data.ts --preset 1m --force",
    "beta:load": "tsx src/beta-load-cli.ts",
    "catalog:migrate": "tsx src/catalog-migration-cli.ts",
    "import:drafts": "tsx src/library-import-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:import-scale": "cross-env RUN_IMPORT_SCALE=1 vitest run src/library-import-scale.test.ts",
    "test:database": "cross-env RUN_DATABASE_INTEGRATION=1 vitest run src/integration/public-read-store.test.ts src/integration/catalog-migration.test.ts src/integration/library-import-store.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1109.0",
    "@aws-sdk/s3-presigned-post": "^3.1109.0",
    "@clerk/backend": "^3.11.7",
    "@hono/node-server": "^2.0.10",
    "@xmldom/xmldom": "^0.9.11",
    "hono": "^4.12.30",
    "jpeg-js": "^0.4.4",
    "pg": "^8.22.0",
    "pngjs": "^7.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/pg": "^8.20.0",
    "@types/pngjs": "^6.0.5",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "ajv": "^8.20.0",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "vitest": "^4.1.10",
    "yazl": "^3.3.1"
  }
}
