    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  }
}
