{
  "name": "@opensymbols/search-import",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "search-import": "node --env-file-if-exists=../../.env.benchmark --import tsx src/cli.ts",
    "search-rebuild": "node --env-file-if-exists=../../.env.search-indexer --import tsx src/cli.ts",
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:database": "cross-env RUN_DATABASE_INTEGRATION=1 vitest run src/postgres-export.integration.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "pg": "^8.22.0"
  }
}
