{
  "name": "opensymbols-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm legacy:up && pnpm dev:apps",
    "dev:apps": "pnpm --parallel --stream --filter @opensymbols/site --filter @opensymbols/server dev",
    "legacy:up": "docker compose up -d --build --wait postgres legacy-server",
    "legacy:seed": "pnpm legacy:up && docker compose exec legacy-server bundle exec rails db:seed",
    "legacy:down": "docker compose down",
    "legacy:logs": "docker compose logs -f legacy-server",
    "build": "pnpm --filter @opensymbols/site --filter @opensymbols/server build",
    "typecheck": "pnpm --filter @opensymbols/site --filter @opensymbols/server typecheck",
    "lint": "eslint apps/site apps/server",
    "test": "pnpm test:apps && pnpm test:legacy",
    "test:apps": "pnpm --filter @opensymbols/site --filter @opensymbols/server test",
    "test:legacy": "docker compose build legacy-server && docker compose run --rm -e RAILS_ENV=test -e DATABASE_URL=postgresql://opensymbols:opensymbols@postgres:5432/opensymbols_test legacy-server bundle exec rails db:create db:schema:load test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.64.0"
  }
}
